# Telegram
BOT_TOKEN=
# Comma-separated Telegram user ids allowed to use the bot. Empty = nobody.
ALLOWED_USER_IDS=

# Ollama
OLLAMA_HOST=http://localhost:11434
MODEL_EXTRACT=gemma4:12b
MODEL_VISION=gemma4:12b
# Keep the model resident between jobs so a batch does not reload it every time.
OLLAMA_KEEP_ALIVE=30m
# 8192 keeps gemma4:12b fully in an 8GB card's VRAM. A larger value pushes part
# of the model onto the CPU and makes every call several times slower.
OLLAMA_NUM_CTX=8192

# Whisper
WHISPER_MODEL=large-v3
# auto | cuda | cpu
WHISPER_DEVICE=auto
# Leave empty to pick float16 on cuda / int8 on cpu.
WHISPER_COMPUTE_TYPE=

# Frames: auto = only when the transcript is too thin to be useful
# always | auto | never
VISION_MODE=auto
MAX_FRAMES=4
MIN_TRANSCRIPT_CHARS=200
# Cosine similarity above which a new entry gets flagged as a likely duplicate
# of an existing one (does not block saving). Empirically measured: unrelated
# topics score ~0.10-0.15, near-exact resubmissions score ~0.80 — 0.75 leaves
# margin below true duplicates. Do not raise to 0.90+, it never fires.
DUPLICATE_SIMILARITY_THRESHOLD=0.75

# Storage
# Leave both empty for standalone mode: everything lives inside this repo's own
# data/ folder (data/archive, data/kb_db) and works with zero extra setup.
#
# ARCHIVE_DIR — override only if you want the markdown archive somewhere else.
ARCHIVE_DIR=
# GRAPHIFY_DIR — set this ONLY if you already run Graphify (a separate local
# knowledge-base tool) and want this bot's saves to land in its database too.
# Point it at that project's root folder, e.g. C:\path\to\Graphify
GRAPHIFY_DIR=
# Free-form label written into every saved entry's metadata. Useful to tell
# entries from different sources/bots apart if you search a shared database.
PROJECT_LABEL=Promtlarim

# yt-dlp: empty, or a browser name (chrome/edge/firefox) to reuse its Instagram
# session. Use a burner account — automated downloading can get an account limited.
YTDLP_COOKIES_FROM_BROWSER=

# --- Vertex AI (ixtiyoriy, faqat vertex backend ishlatilsa) ---
# Google Cloud loyiha ID'si
VERTEX_PROJECT=
# Mintaqa (odatda "global")
VERTEX_LOCATION=global
# gcloud PATH da bo'lsa bo'sh qoldiring; aks holda to'liq yo'l:
# GCLOUD_PATH=C:\Path\To\google-cloud-sdk\bin\gcloud.cmd
GCLOUD_PATH=
